# Copy to ".env.local" and adjust. Only VITE_* variables reach the browser,
# so NEVER put secrets (passwords, API keys) here.

# Where the backend runs
VITE_API_URL=http://localhost:8080

# Show one-click demo logins on the login page (for demos only; set false in production)
VITE_DEMO_MODE=false
# Password of the demo accounts created by the backend's SEED_DEMO_DATA
VITE_DEMO_PASSWORD=Password123!
