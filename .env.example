# Copy to ".env.local" and adjust. Only VITE_* variables reach the browser,
# so NEVER put secrets (passwords, API keys) here.

# ---- Normal setup: leave VITE_API_URL unset ----
# The page calls /api on its own address and Vite forwards it to the backend.
# This works on localhost, other computers in the network and through a tunnel.
# BACKEND_URL=http://localhost:8080
# Extra host names allowed to open the app (comma separated), e.g. your own domain:
# ALLOWED_HOSTS=eams.example.com

# Only if the backend must be called directly (no forwarding):
# VITE_API_URL=http://localhost:8080

# Show one-click demo logins on the login page.
# Keep FALSE while the app is reachable from the internet.
VITE_DEMO_MODE=false
# Password of the demo accounts created by the backend's SEED_DEMO_DATA
VITE_DEMO_PASSWORD=Password123!
